# Q-TeleScope VM bundle — copy to .env and adjust (setup.sh does this automatically).
# PostgreSQL + Redis are the supported demo/production stack (not SQLite).

ENVIRONMENT=production
QRE_PROFILE=production
REQUIRE_API_AUTH=true
ENFORCE_RBAC=true
BLOCK_DEFAULT_BOOTSTRAP_CREDENTIALS=true
PERSIST_API_SESSIONS=true
E2E_CAPTCHA_BYPASS=false
ALLOW_ENV_CREDENTIAL_WRITE=false
TRUSTED_PROXY_RATE_LIMIT=true

# Public event booth (org self-register + mock fleet). VAPT: set ALLOW_PUBLIC_REGISTRATION=false
EVENT_PUBLIC_DEMO=true
ALLOW_PUBLIC_REGISTRATION=true
ENABLE_MOCK_DATA=true
HYBRID_DEMO_ENABLED=false
DEMO_LIVE_PROVIDERS=

# Registration OTP: auto = email when SMTP_HOST+SMTP_FROM set, else on-screen toast (no SMTP required).
# Force booth toast even with SMTP: REGISTRATION_OTP_DELIVERY=screen
REGISTRATION_OTP_DELIVERY=auto
REGISTRATION_REQUIRES_ADMIN_APPROVAL=false

# Replace after unzip (setup.sh generates if missing)
SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32
CORS_ORIGINS=http://127.0.0.1:4173
PUBLIC_APP_URL=http://127.0.0.1:4173

# Bootstrap passwords — setup.sh writes unique values for event profile
ADMIN_USERNAME=admin
USER_USERNAME=user_researcher
SUPERADMIN_USERNAME=superadmin

# Database (PostgreSQL — run scripts/vm-postgres-migrate.sh or setup.sh)
DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@127.0.0.1:5432/quantum_telemetry
USE_ALEMBIC=true
COLLECTION_SCHEDULER_ENABLED=true
STARTUP_HARDWARE_DISCOVERY=auto
BOOTSTRAP_DISCOVERY_ON_EMPTY=true

# Cache (Redis — setup.sh runs scripts/vm-ensure-redis-cache.sh)
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_ENABLED=true
CACHE_NAMESPACE=qtelescope

# SMTP optional — leave unset for toast OTP at events
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=