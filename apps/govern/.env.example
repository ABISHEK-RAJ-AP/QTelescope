# Govern Vite dev — copy to .env.local for overrides
# API proxy target (vite.config) defaults to http://127.0.0.1:8000

# Set false to require real /auth/me token (S0 pilot — no dev header bypass UI)
# VITE_QRE_DEV_HEADERS=false
# Optional local demo login overrides (must match backend bootstrap users):
# VITE_QRE_DEMO_ADMIN_USER=admin
# VITE_QRE_DEMO_ADMIN_PASS=quantum2026
# VITE_QRE_DEMO_OPERATOR_USER=user_researcher
# VITE_QRE_DEMO_OPERATOR_PASS=quantum2026
