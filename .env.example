# ==============================================================================
# Quantum Monitoring Platform .env.example
# ==============================================================================

ENABLE_MOCK_DATA=true

# With ENABLE_MOCK_DATA=true, registration OTP shows in toast + UI (no SMTP). Override:
# REGISTRATION_OTP_DELIVERY=screen

# Profile: leave empty for lab; set production for VAPT / VM go-live
# ENVIRONMENT=production
# QRE_PROFILE=production

# Authentication
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=quantum2026

ADMIN_USERNAME=admin
ADMIN_PASSWORD=quantum2026

USER_USERNAME=user_researcher
USER_PASSWORD=quantum2026

# REQUIRED in production — random 32+ bytes (openssl rand -hex 32)
SECRET_KEY=your_secret_key_here

# --- Production / VAPT (auto-ON when ENVIRONMENT=production; set explicitly for clarity) ---
# REQUIRE_API_AUTH=true
# ENFORCE_RBAC=true
# BLOCK_DEFAULT_BOOTSTRAP_CREDENTIALS=true
# ALLOW_ENV_CREDENTIAL_WRITE=false
# CORS_ORIGINS=https://qtelescope.example.gov.in
# AUTH_RATE_LIMIT=20
# AUTH_RATE_WINDOW_SEC=60
# TRUSTED_PROXY_RATE_LIMIT=true   # booth/nginx — per X-Real-IP when peer is 127.0.0.1
# STARTUP_CONFIG_STRICT=true      # production misconfig aborts startup
# PERSIST_API_SESSIONS=true

# Playwright lab only — never enable on production profile (captcha code BYPASS)
# E2E_CAPTCHA_BYPASS=true

# Production: false. Lab/demo VM may set true (see scripts/vm-demo-env.sh).
# Internet event booth: scripts/vm-event-public-demo.sh sets both:
# EVENT_PUBLIC_DEMO=true
# ALLOW_PUBLIC_REGISTRATION=true

# Registration OTP: auto (default), screen (show code in UI+toast), or email (needs SMTP_*).
# Use screen when SMTP_HOST is set for other mail but you still want on-screen codes locally.
# REGISTRATION_OTP_DELIVERY=screen

# --- Email (registration OTP + password reset when REGISTRATION_OTP_DELIVERY=auto|email) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.gov.in
# PUBLIC_APP_URL=https://qtelescope.example.gov.in
# REGISTRATION_OTP_DELIVERY=auto

# Hardware Provider Keys
IBM_QUANTUM_TOKEN=
RIGETTI_API_KEY=
IONQ_API_KEY=
ONPREM_QPU_URL=http://localhost:8080

# Database (PostgreSQL default)
# Docker compose uses postgrespassword; local Miniforge setup uses password root (see scripts/setup-local-infra.sh)
DATABASE_URL=postgresql+psycopg2://postgres:root@localhost:5432/quantum_telemetry
USE_ALEMBIC=true
COLLECTION_SCHEDULER_ENABLED=true
# auto = skip startup discovery when scheduler enabled; true = always on boot; false = never
STARTUP_HARDWARE_DISCOVERY=auto
# One-time seed when backends table is empty (read paths never run full discovery)
BOOTSTRAP_DISCOVERY_ON_EMPTY=true

# Cache (Redis / Valkey — same protocol)
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_NAMESPACE=qtelescope

# Optional pool tuning
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# CACHE_TTL_HEALTH_VECTOR=10
# CACHE_TTL_ALERTS_SUMMARY=8

# Legacy SQLite (tests only)
# DATABASE_URL=sqlite:///./data/qtelescope.db
