# ==============================================================================
# Quantum Monitoring Platform .env.example
# ==============================================================================

ENABLE_MOCK_DATA=true

# Authentication
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=quantum2026

ADMIN_USERNAME=admin
ADMIN_PASSWORD=quantum2026

USER_USERNAME=user_researcher
USER_PASSWORD=quantum2026

SECRET_KEY=your_secret_key_here

# Hardware Provider Keys
IBM_QUANTUM_TOKEN=
RIGETTI_API_KEY=
IONQ_API_KEY=
ONPREM_QPU_URL=http://localhost:8080

# Database (PostgreSQL default)
# Docker compose uses postgrespassword; local Miniforge setup uses password root (see scripts/setup-local-infra.sh)
DATABASE_URL=postgresql+psycopg2://postgres:root@localhost:5432/quantum_telemetry
USE_ALEMBIC=true
COLLECTION_SCHEDULER_ENABLED=true

# Cache (Redis / Valkey — same protocol)
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_NAMESPACE=qtelescope

# Optional pool tuning
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# CACHE_TTL_HEALTH_VECTOR=10
# CACHE_TTL_ALERTS_SUMMARY=8

# Legacy SQLite (tests only)
# DATABASE_URL=sqlite:///./data/qtelescope.db
