# Copy to .env on the VM for production / VAPT / UAT.
# Never commit the real .env.

ENVIRONMENT=production
QRE_PROFILE=production

ENABLE_MOCK_DATA=false
COLLECTION_SCHEDULER_ENABLED=true
USE_ALEMBIC=true

SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_STRONG_PASSWORD
USER_USERNAME=user_researcher
USER_PASSWORD=REPLACE_STRONG_PASSWORD

REQUIRE_API_AUTH=true
ENFORCE_RBAC=true
BLOCK_DEFAULT_BOOTSTRAP_CREDENTIALS=true
ALLOW_ENV_CREDENTIAL_WRITE=false
PERSIST_API_SESSIONS=true

# Exact browser origin(s) — no wildcard in production
CORS_ORIGINS=https://YOUR_VM_HOSTNAME_OR_IP
# Browser origin for links in password-reset email (usually same host as UI)
PUBLIC_APP_URL=https://YOUR_VM_HOSTNAME_OR_IP

# Password reset (required in production — dev_reset_token is never returned)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@YOUR_ORG
SMTP_USE_TLS=true

DATABASE_URL=postgresql+psycopg2://postgres:REPLACE@db:5432/quantum_telemetry
REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=true
CACHE_NAMESPACE=qtelescope

IBM_QUANTUM_TOKEN=
# Optional — QCS hardware ISA is public without a key
RIGETTI_API_KEY=
IONQ_API_KEY=
ONPREM_QPU_URL=

# SQLite only if this VM has no Postgres. Redis optional (in-memory rate-limit if unset).
# DATABASE_URL=sqlite:///./data/qtelescope.db
# REDIS_URL=
